{
  "className": "ShippingRecord",
  "fields": {
    "gc_fin_year": {
      "type": "string",
      "description": "Financial year (e.g., 2025/26)",
      "required": false
    },
    "month": {
      "type": "string",
      "description": "Month of shipment",
      "required": false
    },
    "port": {
      "type": "string",
      "description": "Port of loading",
      "required": true
    },
    "reference_number": {
      "type": "int",
      "description": "Unique slot reference number (numeric)",
      "required": false
    },
    "exporter": {
      "type": "string",
      "description": "Exporter company code",
      "required": false
    },
    "vessel_name": {
      "type": "string",
      "description": "Name of ship",
      "required": false
    },
    "eta_date": {
      "type": "string",
      "description": "Expected arrival date",
      "required": false
    },
    "loading_start": {
      "type": "string",
      "description": "Date loading commences",
      "required": false
    },
    "etd_date": {
      "type": "string",
      "description": "Expected departure date",
      "required": false
    },
    "nomination_received_date": {
      "type": "string",
      "description": "Date nomination was received",
      "required": false
    },
    "nomination_accepted_date": {
      "type": "string",
      "description": "Date nomination was accepted",
      "required": false
    },
    "status": {
      "type": "string",
      "description": "Current status of shipment",
      "required": false
    },
    "commodity": {
      "type": "string",
      "description": "Type of commodity being shipped",
      "required": false
    },
    "quantity_tonnes": {
      "type": "float",
      "description": "Quantity in tonnes",
      "required": false
    },
    "note": {
      "type": "string",
      "description": "Any observations or data quality notes",
      "required": false
    }
  }
}
